---
import BioLayout from '../../layouts/BioLayout.astro';
import ClusterRegioesHub from '../../components/bio/ClusterRegioesHub.astro';
import ContatoCta from '../../components/bio/sections/ContatoCta.astro';
import { getClusterById, getClusterPages } from '../../lib/clusters';
import { groupPagesByCity } from '../../lib/cluster-regions';
import { isThinHubNoindex } from '../../lib/hub-health';

const cluster = getClusterById('descupinizacao')!;
const pages = getClusterPages('descupinizacao');

const pageTitle = `Descupinização por região | Grande São Paulo | Cupim Eco`;

const cities = groupPagesByCity(pages);
const pageDescription = `Descupinização em ${cities.length}+ cidades da Grande São Paulo. Cupim subterrâneo e madeira seca com garantia. Ligue 0800 111 7272.`;
const noindex = isThinHubNoindex(cluster.hubRegioes);
---

<BioLayout variant="content" title={pageTitle} description={pageDescription} noindex={noindex}>
	<ClusterRegioesHub cluster={cluster} pages={pages} />
	<ContatoCta />
</BioLayout>
